<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:paddingLeft="13dp"
    android:paddingTop="9dp"
    android:paddingRight="12dp"
    android:paddingBottom="12dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PRIVATE DNS"
            android:textColor="?attr/widgetTextMuted"
            android:textSize="11sp"
            android:textStyle="bold" />
        <FrameLayout
            android:minHeight="16dp"
            android:id="@+id/widget_status_area"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="10dp">
            <TextView
                android:id="@+id/widget_status_success"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="OFF"
                android:textColor="?attr/widgetSuccess"
                android:textSize="11sp"
                android:textStyle="bold"
                android:gravity="center_vertical"
                android:visibility="gone" />
            <TextView
                android:id="@+id/widget_status_error"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="OFF"
                android:textColor="?attr/widgetError"
                android:textSize="11sp"
                android:textStyle="bold"
                android:gravity="center_vertical"
                android:visibility="gone" />
            <TextView
                android:id="@+id/widget_status_warning"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="OFF"
                android:textColor="?attr/widgetWarning"
                android:textSize="11sp"
                android:textStyle="bold"
                android:gravity="center_vertical"
                android:visibility="visible" />
        </FrameLayout>
        <TextView
            android:id="@+id/widget_settings"
            android:layout_width="40dp"
            android:layout_height="29dp"
            android:contentDescription="Edit DNS servers"
            android:gravity="center"
            android:text="⚙"
            android:textColor="?attr/widgetTextSecondary"
            android:textSize="21sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/widget_profile_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">
        <TextView
            android:id="@+id/widget_profile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="DNS AI"
            android:textColor="?attr/widgetTextPrimary"
            android:textSize="19sp"
            android:textStyle="bold" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/widget_hostname"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="dns.dns-ai.ru"
                android:textColor="?attr/widgetTextSecondary"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/widget_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="7dp"
                android:text="1 / 3 servers"
                android:textColor="?attr/widgetTextMuted"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="43dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/widget_power"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginRight="5dp"
            android:layout_weight="1.25"
            android:background="@drawable/widget_button_primary"
            android:contentDescription="Enable or disable selected Private DNS server"
            android:gravity="center"
            android:text="TURN ON"
            android:textColor="?attr/widgetTextOnPrimary"
            android:textSize="12sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/widget_previous"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginRight="5dp"
            android:layout_weight="1"
            android:background="@drawable/widget_button_secondary"
            android:contentDescription="Apply previous DNS server"
            android:gravity="center"
            android:text="◀ PREV"
            android:textColor="?attr/widgetTextPrimary"
            android:textSize="12sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/widget_next"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_button_secondary"
            android:contentDescription="Apply next DNS server"
            android:gravity="center"
            android:text="NEXT ▶"
            android:textColor="?attr/widgetTextPrimary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>