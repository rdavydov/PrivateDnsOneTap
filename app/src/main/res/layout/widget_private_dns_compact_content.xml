<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="10dp"
    android:paddingTop="6dp"
    android:paddingRight="7dp"
    android:paddingBottom="6dp">
    <LinearLayout
        android:id="@+id/widget_profile_area"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">
        <FrameLayout
            android:minHeight="14dp"
            android:id="@+id/widget_status_area"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/widget_status_success"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="OFF"
                android:textColor="?attr/widgetSuccess"
                android:textSize="9sp"
                android:textStyle="bold"
                android:gravity="center_vertical"
                android:visibility="gone" />
            <TextView
                android:id="@+id/widget_status_error"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="OFF"
                android:textColor="?attr/widgetError"
                android:textSize="9sp"
                android:textStyle="bold"
                android:gravity="center_vertical"
                android:visibility="gone" />
            <TextView
                android:id="@+id/widget_status_warning"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="OFF"
                android:textColor="?attr/widgetWarning"
                android:textSize="9sp"
                android:textStyle="bold"
                android:gravity="center_vertical"
                android:visibility="visible" />
        </FrameLayout>
        <TextView
            android:id="@+id/widget_profile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="DNS AI"
            android:textColor="?attr/widgetTextPrimary"
            android:textSize="14sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/widget_hostname"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="dns.dns-ai.ru"
            android:textColor="?attr/widgetTextSecondary"
            android:textSize="9sp" />
    </LinearLayout>
    <TextView
        android:id="@+id/widget_power"
        android:layout_width="52dp"
        android:layout_height="48dp"
        android:layout_marginLeft="5dp"
        android:background="@drawable/widget_button_primary"
        android:contentDescription="Enable or disable selected Private DNS server"
        android:gravity="center"
        android:text="ON"
        android:textColor="?attr/widgetTextOnPrimary"
        android:textSize="9sp"
        android:textStyle="bold" />
    <LinearLayout
        android:layout_width="39dp"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <TextView
            android:id="@+id/widget_next"
            android:layout_width="39dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:contentDescription="Apply next DNS server"
            android:gravity="center"
            android:text="▶"
            android:textColor="?attr/widgetTextPrimary"
            android:textSize="19sp" />
        <TextView
            android:id="@+id/widget_settings"
            android:layout_width="39dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:contentDescription="Edit DNS servers"
            android:gravity="center"
            android:text="⚙"
            android:textColor="?attr/widgetTextSecondary"
            android:textSize="17sp" />
    </LinearLayout>
</LinearLayout>