<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="WidgetThemeLightBase" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="widgetBackground">@color/widgetBackground_light</item>
        <item name="widgetStroke">@color/widgetStroke_light</item>
        <item name="widgetPowerBackground">@color/widgetPowerBackground_light</item>
        <item name="widgetPickerBackground">@color/widgetPickerBackground_light</item>
        <item name="widgetButtonPrimary">@color/widgetButtonPrimary_light</item>
        <item name="widgetButtonSecondary">@color/widgetButtonSecondary_light</item>
        <item name="widgetTextPrimary">@color/widgetTextPrimary_light</item>
        <item name="widgetTextSecondary">@color/widgetTextSecondary_light</item>
        <item name="widgetTextMuted">@color/widgetTextMuted_light</item>
        <item name="widgetTextOnPrimary">@color/widgetTextOnPrimary_light</item>
        <item name="widgetSuccess">@color/widgetSuccess_light</item>
        <item name="widgetError">@color/widgetError_light</item>
        <item name="widgetWarning">@color/widgetWarning_light</item>
