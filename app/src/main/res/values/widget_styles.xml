        <item name="widgetTextOnPrimary">@color/widgetTextOnPrimary_dark</item>
        <item name="widgetSuccess">@color/widgetSuccess_dark</item>
        <item name="widgetError">@color/widgetError_dark</item>
        <item name="widgetWarning">@color/widgetWarning_dark</item>
    </style>
    <style name="WidgetTheme.Light" parent="WidgetThemeLightBase" />
    <style name="WidgetTheme.Dark" parent="WidgetThemeDarkBase" />
    <style name="WidgetTheme.System" parent="WidgetTheme.Light" />
</resources>
